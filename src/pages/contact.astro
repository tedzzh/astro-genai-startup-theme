---
import Layout from '../layouts/main.astro';
import { Button } from '@/components/ui/button';
import { Mail, MapPin, Phone, Send } from 'lucide-react';
---

<Layout title="联系我们 - 浙里修" description="预约维修或咨询，欢迎通过表单或电话、微信联系浙里修。">
	<section class="py-20 md:py-32">
		<div class="container mx-auto px-4">
			<div class="max-w-5xl mx-auto">
				<div class="text-center space-y-4 mb-8">
					<h1 class="text-4xl md:text-6xl font-bold">
						浙里修
						<span class="bg-gradient-to-r from-purple-600 to-pink-600 dark:from-purple-400 dark:to-pink-400 bg-clip-text text-transparent">
							工作室简介
						</span>
					</h1>
					<p class="text-xl text-muted-foreground max-w-2xl mx-auto">
						用专业与技术，做好每一单维修。
					</p>
				</div>

				<div class="max-w-3xl mx-auto mb-16 text-left md:text-center space-y-4">
					<p class="text-muted-foreground">
						浙里修是一家专注于芯片级维修与综合技术服务的个人工作室。我们主要承接计算机芯片级维修、工控设备维修、无人机维修，以及软件脚本开发、网络设计维护等业务，并持续在特斯拉相关领域进修，力求为企业和个人客户提供专业、透明、可靠的一站式服务。
					</p>
					<p class="text-muted-foreground">
						我们坚持先检测后报价、不修不收费的原则，采用原厂或优质配件，并提供合理的质保期。无论是一台电脑、一块工控板，还是一架无人机，我们都用同样的专业态度对待。
					</p>
				</div>

				<div class="text-center space-y-3 mb-10">
					<h2 class="text-3xl md:text-4xl font-bold">
						联系
						<span class="bg-gradient-to-r from-purple-600 to-pink-600 dark:from-purple-400 dark:to-pink-400 bg-clip-text text-transparent">
							我们
						</span>
					</h2>
					<p class="text-base md:text-lg text-muted-foreground max-w-2xl mx-auto">
						预约检测、维修咨询或合作洽谈，欢迎留言，我们会尽快回复。
					</p>
				</div>

				<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
					<div class="lg:col-span-2">
						<div class="p-8 rounded-2xl border bg-card">
							<h2 class="text-2xl font-bold mb-6">发送消息</h2>
							
							<form action="https://api.web3forms.com/submit" method="POST" class="space-y-6">
								<input type="hidden" name="access_key" value="6e1aedd9-3727-48e7-9249-49f0a16f1e37">
								
								<input type="hidden" name="from_name" value="浙里修官网留言系统">
								<input type="hidden" name="subject" value="收到新的维修咨询/预约">
								
								<input type="checkbox" name="botcheck" class="hidden" style="display: none;">

								<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
									<div>
										<label for="name" class="block text-sm font-medium mb-2">
											姓名
										</label>
										<input
											type="text"
											id="name"
											name="name"
											class="flex h-10 w-full rounded-md border bg-background px-3 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
											placeholder="您的姓名"
											required
										/>
									</div>
									<div>
										<label for="email" class="block text-sm font-medium mb-2">
											邮箱
										</label>
										<input
											type="email"
											id="email"
											name="email"
											class="flex h-10 w-full rounded-md border bg-background px-3 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
											placeholder="your@email.com"
											required
										/>
									</div>
								</div>

								<div>
									<label for="phone" class="block text-sm font-medium mb-2">
										电话 / 微信
									</label>
									<input
										type="text"
										id="phone"
										name="phone"
										class="flex h-10 w-full rounded-md border bg-background px-3 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
										placeholder="方便我们联系您"
										required
									/>
								</div>

								<div>
									<label for="subject" class="block text-sm font-medium mb-2">
										主题
									</label>
									<input
										type="text"
										id="form_subject"
										name="customer_subject"
										class="flex h-10 w-full rounded-md border bg-background px-3 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
										placeholder="例如：笔记本主板维修、工控机检测"
										required
									/>
								</div>

								<div>
									<label for="message" class="block text-sm font-medium mb-2">
										留言
									</label>
									<textarea
										id="message"
										name="message"
										rows="6"
										class="flex w-full rounded-md border bg-background px-3 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring resize-none"
										placeholder="请简单描述设备型号、故障现象或需求..."
										required
									></textarea>
								</div>

								<button
									type="submit"
									class="inline-flex items-center justify-center gap-2 h-10 px-6 rounded-md bg-primary text-primary-foreground font-medium hover:bg-primary/90 transition-colors w-full md:w-auto"
								>
									<Send class="h-4 w-4" />
									发送消息
								</button>
							</form>
						</div>
					</div>

					<div class="space-y-6">
						<div class="p-6 rounded-2xl border bg-card">
							<div class="inline-flex p-3 rounded-xl bg-gradient-to-br from-purple-500 to-pink-500 mb-4">
								<Mail class="h-6 w-6 text-white" />
							</div>
							<h3 class="text-lg font-semibold mb-2">邮箱</h3>
							<p class="text-muted-foreground">ted.zhangxiao@gmail.com</p>
						</div>

						<div class="p-6 rounded-2xl border bg-card">
							<div class="inline-flex p-3 rounded-xl bg-gradient-to-br from-blue-500 to-cyan-500 mb-4">
								<Phone class="h-6 w-6 text-white" />
							</div>
							<h3 class="text-lg font-semibold mb-2">电话 / 微信</h3>
							<p class="text-muted-foreground">133 6219 6979 / 188 5862 3977</p>
						</div>

						<div class="p-6 rounded-2xl border bg-card">
							<div class="inline-flex p-3 rounded-xl bg-gradient-to-br from-green-500 to-emerald-500 mb-4">
								<MapPin class="h-6 w-6 text-white" />
							</div>
							<h3 class="text-lg font-semibold mb-2">地址 / 到店</h3>
							<p class="text-muted-foreground">
								浙江省 台州市 椒江区 葭沚街道
							</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
</Layout>
