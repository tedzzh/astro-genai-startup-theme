---
import Layout from '../layouts/main.astro';
import { withBase } from '@/lib/utils';
import { Target, Zap, Users, Heart } from 'lucide-react';
---

<Layout title="关于我们 - 浙里修" description="浙里修芯片级维修工作室：专业从事计算机芯片级维修、工控设备维修、无人机维修、脚本开发与网络维护。">
	<section class="py-20 md:py-32">
		<div class="container mx-auto px-4">
			<div class="max-w-4xl mx-auto">
				<div class="text-center space-y-4 mb-16">
					<h1 class="text-4xl md:text-6xl font-bold">
						关于
						<span class="bg-gradient-to-r from-purple-600 to-pink-600 dark:from-purple-400 dark:to-pink-400 bg-clip-text text-transparent">
							浙里修
						</span>
					</h1>
					<p class="text-xl text-muted-foreground max-w-2xl mx-auto">
						用专业与技术，做好每一单维修
					</p>
				</div>

				<!-- 占位图：替换为 public/images/about-workshop.jpg -->
				<div class="aspect-video rounded-2xl bg-muted mb-16 overflow-hidden">
					<img src="/images/about-workshop.jpg" alt="" class="h-full w-full object-cover" />
				</div>

				<!-- 工作室介绍 -->
				<div class="prose prose-lg dark:prose-invert mx-auto mb-16">
					<h2>工作室简介</h2>
					<p>
						浙里修是一家专注于芯片级维修与综合技术服务的个人工作室。我们主要承接计算机芯片级维修、工控设备维修、无人机维修，以及软件脚本开发、网络设计维护等业务，并持续在特斯拉相关领域进修，力求为企业和个人客户提供专业、透明、可靠的一站式服务。
					</p>
					<p>
						我们坚持先检测后报价、不修不收费的原则，采用原厂或优质配件，并提供合理的质保期。无论是一台电脑、一块工控板，还是一架无人机，我们都用同样的专业态度对待。
					</p>
				</div>

				<!-- 价值观 -->
				<div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16">
					<div class="p-6 rounded-2xl border bg-card">
						<div class="inline-flex p-3 rounded-xl bg-gradient-to-br from-purple-500 to-pink-500 mb-4">
							<Target class="h-6 w-6 text-white" />
						</div>
						<h3 class="text-xl font-semibold mb-2">使命</h3>
						<p class="text-muted-foreground">
							用芯片级技术与规范流程，让每一台设备都能被认真对待，让客户省心、放心。
						</p>
					</div>

					<div class="p-6 rounded-2xl border bg-card">
						<div class="inline-flex p-3 rounded-xl bg-gradient-to-br from-blue-500 to-cyan-500 mb-4">
							<Zap class="h-6 w-6 text-white" />
						</div>
						<h3 class="text-xl font-semibold mb-2">愿景</h3>
						<p class="text-muted-foreground">
							成为您身边最靠谱的维修与技术伙伴，从电脑、工控到无人机，一站解决。
						</p>
					</div>

					<div class="p-6 rounded-2xl border bg-card">
						<div class="inline-flex p-3 rounded-xl bg-gradient-to-br from-green-500 to-emerald-500 mb-4">
							<Users class="h-6 w-6 text-white" />
						</div>
						<h3 class="text-xl font-semibold mb-2">专业</h3>
						<p class="text-muted-foreground">
							芯片级维修、BGA 焊接、工控与无人机实战经验，并持续学习新技术。
						</p>
					</div>

					<div class="p-6 rounded-2xl border bg-card">
						<div class="inline-flex p-3 rounded-xl bg-gradient-to-br from-pink-500 to-rose-500 mb-4">
							<Heart class="h-6 w-6 text-white" />
						</div>
						<h3 class="text-xl font-semibold mb-2">原则</h3>
						<p class="text-muted-foreground">
							透明报价、质保清晰、不夸大故障，修不好不收费。
						</p>
					</div>
				</div>

				<!-- 数据 -->
				<div class="grid grid-cols-3 gap-8 py-12 border-y">
					<div class="text-center">
						<div class="text-3xl md:text-4xl font-bold mb-2">98%</div>
						<p class="text-sm text-muted-foreground">准时到达率</p>
					</div>
					<div class="text-center">
						<div class="text-3xl md:text-4xl font-bold mb-2">100%</div>
						<p class="text-sm text-muted-foreground">原厂/优质配件</p>
					</div>
					<div class="text-center">
						<div class="text-3xl md:text-4xl font-bold mb-2">5k+</div>
						<p class="text-sm text-muted-foreground">好评服务案例</p>
					</div>
				</div>

				<div class="text-center mt-16">
					<h2 class="text-2xl md:text-3xl font-bold mb-4">欢迎合作</h2>
					<p class="text-muted-foreground mb-6">
						企业维保、批量维修、长期合作，欢迎联系洽谈
					</p>
					<div class="flex flex-col sm:flex-row gap-4 justify-center">
						<a href={withBase("/contact")} class="inline-flex items-center justify-center h-10 px-6 rounded-md bg-primary text-primary-foreground font-medium hover:bg-primary/90 transition-colors">
							联系我们
						</a>
					</div>
				</div>
			</div>
		</div>
	</section>
</Layout>
